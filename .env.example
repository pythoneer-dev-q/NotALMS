# ! .env.example — скопируй в .env и заполни
# сеть
HOST=127.0.0.1
PORT=8004
FRONT_HOST=127.0.0.1
FRONT_PORT=8005
BACK_PORT=8004
# BACK_PORT/FRONT_PORT — порты наружу в docker compose (внутри контейнеров 8004/8005)

# ssl: пусто = http; для докера обычно /certs/cert.pem и /certs/key.pem
SSL_CERTFILE=
SSL_KEYFILE=
# 1 = entrypoint сгенерит self-signed (только dev)
DEV_CERTS=

# cors через запятую; '*' только для разработки
CORS_ORIGINS=*

# mongo
MONGO_URI=mongodb://localhost:27017/
MONGO_CLUSTER=ntlms
MONGO_USERS=nt_users
MONGO_LMSCLUSTER=ntlmsdata
MONGO_LMSLESSONS=ntlessons
MONGO_LMSCOURSESDATA=ntcourses
MONGO_LMSPROGRESS=ntprogress
MONGO_LMSTASKS=nttasks
MONGO_LMSTESTS=nttests

# jwt — сгенерируй свой, минимум 64 символа
SECRET_KEY=change_me_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# бот (получить у @BotFather)
BOT_TOKEN=
BOT_DB_NAME=ntlmsauth
OTPLEN=6

# пароль панели админа (/adminSecret)
ADMIN_SECRET=

# производительность
WORKERS=1
MONGO_MAX_POOL=100
CACHE_TTL=60
RATE_LIMIT=20/minute
# redis для горячих данных; пусто = кэш в памяти процесса
REDIS_URL=
