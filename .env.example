# ! .env.example — скопируй в .env и заполни (или запусти scripts/install.sh — он сам всё сгенерит)
# сеть: PORT/FRONT_PORT — порты прослушивания приложения,
#       BACK_PORT/FRONT_PORT_HOST — порты наружу (docker compose)
HOST=127.0.0.1
PORT=8004
FRONT_HOST=127.0.0.1
FRONT_PORT=8005
BACK_PORT=8004
FRONT_PORT_HOST=8005

# публичный адрес фронта: бот строит из него ссылки входа
# (docker: https://домен или http://ip:порт)
PUBLIC_URL=http://127.0.0.1:8005

# ssl: пусто = http; для докера обычно /certs/cert.pem и /certs/key.pem,
# для venv — абсолютные пути к ./certs
SSL_CERTFILE=
SSL_KEYFILE=
# 1 = entrypoint сгенерит self-signed (только dev)
DEV_CERTS=

# cors через запятую; '*' только для разработки
CORS_ORIGINS=*

# mongo
MONGO_URI=mongodb://localhost:27017/
MONGO_CLUSTER=ntlms
MONGO_USERS=nt_users
MONGO_LMSCLUSTER=ntlmsdata
MONGO_LMSLESSONS=ntlessons
MONGO_LMSCOURSESDATA=ntcourses
MONGO_LMSPROGRESS=ntprogress
MONGO_LMSTASKS=nttasks
MONGO_LMSTESTS=nttests

# jwt — сгенерируй свой, минимум 64 символа
SECRET_KEY=change_me_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# бот (получить у @BotFather)
BOT_TOKEN=
BOT_DB_NAME=ntlmsauth
OTPLEN=6

# пароль панели админа (/adminSecret)
ADMIN_SECRET=

# производительность
WORKERS=1
MONGO_MAX_POOL=100
CACHE_TTL=60
RATE_LIMIT=20/minute
# Cloudflare Turnstile: оба ключа пустые = CAPTCHA выключена (локальная разработка)
CAPTCHA_SUSPICIOUS_RPS=15
TURNSTILE_SITE_KEY=0x4AAAAAAE_P3Gw8STD4zk8K
TURNSTILE_SECRET_KEY=0x4AAAAAAE_P3IyJxq0zi6IsRIZeyhTO5PA
# redis для горячих данных; пусто = кэш в памяти процесса
REDIS_URL=
